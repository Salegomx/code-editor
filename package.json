{
  "name": "code-editor",
  "version": "0.1.0",
  "private": true,
  "description": "<code-editor> web component: a form-friendly code editor built on CodeMirror 6.",
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/only-pnpm.js",
    "build": "esbuild src/index.js --bundle --minify --format=iife --target=es2022 --outfile=dist/code-editor.js",
    "dev": "esbuild src/index.js --bundle --format=iife --target=es2022 --sourcemap --outfile=dist/code-editor.js --serve=127.0.0.1:8000 --servedir=. --watch",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
